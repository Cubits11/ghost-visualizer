{
  "name": "ghost-visualizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "generate:evidence": "node scripts/generate-evidence-receipt.mjs",
    "lint:vis001-copy": "node scripts/check-vis001-copy.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "studio": "remotion studio src/Root.tsx",
    "render:vis001": "remotion render src/Root.tsx ShatteringPointEstimateScene renders/vis001.mp4 --chrome-mode=chrome-for-testing --concurrency=2 --timeout=120000",
    "still:vis001": "remotion still src/Root.tsx ShatteringPointEstimateScene renders/stills/vis001.png --frame=1260",
    "still:showcase": "remotion still src/Root.tsx ComponentShowcase renders/stills/component-showcase.png --frame=0",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.484",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "remotion": "^4.0.484",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.9"
  }
}
